{
  "name": "malevo-science",
  "productName": "Malevo Science",
  "version": "0.1.0",
  "description": "Planning, verification and visualization workbench for a hard science fiction setting",
  "main": "./out/main/index.js",
  "author": "Stephen Deken",
  "license": "UNLICENSED",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && node scripts/build-cli.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "package:win": "npm run build && electron-builder --win",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "smoke:ci": "node scripts/smoke.mjs",
    "icon": "node scripts/make-icon.mjs",
    "cli:build": "node scripts/build-cli.mjs",
    "malevo": "node scripts/build-cli.mjs && node out/cli/malevo.mjs",
    "golden:write": "node scripts/golden-write.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@malevo/cli": "*",
    "@malevo/core": "*",
    "@malevo/gen": "*",
    "@malevo/model": "*",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.0.0",
    "vitest": "^5.0.1"
  }
}
